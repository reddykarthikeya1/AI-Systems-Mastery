# ---------------------------------------------------------------------------
#  Course service endpoints
# ---------------------------------------------------------------------------
#  Every port below is deliberately NON-STANDARD so the course never collides
#  with a database you already run natively.
#
#  This is not hypothetical: the machine this course was built on had a native
#  PostgreSQL 17 service on 5432. The course's tests connected to it instead of
#  the container and failed with "password authentication failed" - an error
#  pointing nowhere near the cause. Non-standard ports remove the whole class
#  of problem.
#
#  Override any value to point the tests at your own instance instead.
#  `docker compose up` publishes exactly these ports.
# ---------------------------------------------------------------------------

COURSE_DB_HOST=localhost

# postgres (container listens on 5432)   - Modules 04, 05, 19, 21, 22, 23
COURSE_PG_PORT=15432
COURSE_PG_USER=postgres
COURSE_PG_PASSWORD=coursepw
COURSE_PG_DB=coursedb

# mysql (container listens on 3306)      - Module 06
COURSE_MYSQL_PORT=13306
COURSE_MYSQL_PASSWORD=coursepw

# mongo (container listens on 27017)     - Modules 10, 11
#   Runs with --replSet so Module 11 can use change streams. Connect with
#   ?directConnection=true: the replica set advertises its INTERNAL hostname,
#   which the host cannot resolve, so driver-side discovery would fail.
#   Run `make init-mongo` once after first creating the container.
COURSE_MONGO_PORT=17017

# redis (container listens on 6379)      - Modules 12, 13
COURSE_REDIS_PORT=16379

# cassandra                              - Module 14
#   MAX_HEAP_SIZE is pinned in compose: Cassandra sizes its heap from total host
#   RAM and gets OOM-killed (exit 137) inside Docker Desktop otherwise.
COURSE_CASSANDRA_PORT=9042

# dynamodb-local (container listens on 8000) - Module 15
COURSE_DYNAMO_PORT=18000

# neo4j (container listens on 7687)      - Module 16
COURSE_NEO4J_PORT=17687
NEO4J_USER=neo4j
NEO4J_PWD=coursepw123

# clickhouse (container listens on 8123) - Module 17
COURSE_CLICKHOUSE_PORT=18123

# elasticsearch (container listens on 9200) - Module 19
#   The Python client major version MUST match the server major. An 8.x server
#   with a 9.x client fails with "media_type_header_exception"; pyproject pins
#   elasticsearch>=8.12,<9 for this reason.
COURSE_ES_PORT=19200

# qdrant (container listens on 6333)     - Module 20
COURSE_QDRANT_PORT=16333

# oracle-free (container listens on 1521) - Modules 07, 08, 09
#   Behind a compose profile: `docker compose --profile oracle up -d oracle`
#   (~2 GB image, several minutes to initialise).
COURSE_ORACLE_PORT=11521
ORACLE_USER=system
ORACLE_PWD=coursepw
ORACLE_DSN=localhost:11521/FREEPDB1

# Credentials above are development-only. Never reuse them anywhere real.
